.ai-chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0B0F19;
}

/* header */
.chat-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: rgba(13, 18, 32, 0.95);
  border-bottom: 1px solid rgba(0, 180, 216, 0.1);
  backdrop-filter: blur(12px);
}
.chat-header-icon { font-size: 40rpx; }
.chat-header-title { font-size: 30rpx; font-weight: 600; color: #e2e8f0; }
.chat-header-sub { font-size: 22rpx; color: #556080; margin-top: 2rpx; }

/* messages */
.chat-messages {
  flex: 1;
  padding: 20rpx 24rpx;
  overflow-y: auto;
}
.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx 40rpx;
  text-align: center;
}
.empty-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.empty-title { font-size: 34rpx; font-weight: 600; color: #e2e8f0; margin-bottom: 8rpx; }
.empty-desc { font-size: 26rpx; color: #556080; margin-bottom: 32rpx; }
.quick-questions { display: flex; flex-wrap: wrap; gap: 16rpx; justify-content: center; }
.quick-chip {
  padding: 14rpx 28rpx;
  border-radius: 40rpx;
  border: 1px solid rgba(0, 180, 216, 0.2);
  background: rgba(0, 180, 216, 0.06);
  color: #8899b0;
  font-size: 24rpx;
  transition: all 0.2s;
}
.quick-chip:active {
  background: rgba(0, 180, 216, 0.15);
  border-color: rgba(0, 180, 216, 0.4);
  color: #00b4d8;
}

/* msg row */
.msg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  max-width: 85%;
}
.msg-row.user { align-self: flex-end; flex-direction: row-reverse; margin-left: auto; }
.msg-row.assistant { align-self: flex-start; }
.msg-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(0, 180, 216, 0.1);
  border: 1px solid rgba(0, 180, 216, 0.15);
  font-size: 28rpx;
}
.user-avatar-text { font-weight: 700; font-size: 24rpx; color: #00b4d8; }
.msg-bubble {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #e2e8f0;
  word-break: break-all;
}
.msg-bubble.assistant {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(0, 180, 216, 0.1);
  border-top-left-radius: 6rpx;
}
.msg-bubble.user {
  background: linear-gradient(135deg, rgba(0, 180, 216, 0.2), rgba(108, 60, 220, 0.15));
  border: 1px solid rgba(0, 180, 216, 0.2);
  border-top-right-radius: 6rpx;
}

/* typing */
.msg-bubble.typing {
  display: flex;
  gap: 8rpx;
  padding: 24rpx 28rpx;
}
.typing-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: #556080;
  animation: dotPulse 1.4s infinite ease-in-out both;
}
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes dotPulse {
  0%, 80%, 100% { transform: scale(0.4); opacity: 0.3; }
  40% { transform: scale(1); opacity: 1; }
}

/* input */
.chat-input-area {
  padding: 16rpx 24rpx 24rpx;
  background: rgba(13, 18, 32, 0.95);
  border-top: 1px solid rgba(0, 180, 216, 0.08);
}
.chat-input-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}
.chat-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 200rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  border: 1px solid rgba(0, 180, 216, 0.15);
  background: rgba(15, 23, 42, 0.6);
  color: #e2e8f0;
  font-size: 26rpx;
  line-height: 1.5;
}
.chat-input:focus { border-color: rgba(0, 180, 216, 0.4); }
.send-btn {
  width: 72rpx; height: 72rpx;
  border-radius: 20rpx;
  border: none;
  background: linear-gradient(135deg, #00b4d8, #6c3cdc);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  font-size: 28rpx;
  flex-shrink: 0;
}
.send-btn[disabled] { opacity: 0.3; }
.send-icon { font-size: 28rpx; line-height: 1; }
.clear-row { text-align: center; margin-top: 12rpx; }
.clear-btn { font-size: 22rpx; color: #475569; }
.clear-btn:active { color: #ef4444; }
