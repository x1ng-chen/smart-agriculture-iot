.alerts {
  position: relative;
  padding: 20rpx 24rpx 40rpx;
  min-height: 100vh;
}

/* ═══════════════ Filter Tabs ═══════════════ */

.filter-tabs {
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.tab-inner {
  display: flex;
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 18rpx;
  padding: 6rpx;
  box-shadow:
    0 2rpx 16rpx rgba(0,0,0,0.25),
    inset 0 1rpx 0 rgba(255,255,255,0.02);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-muted);
  border-radius: 14rpx;
  position: relative;
  z-index: 1;
  letter-spacing: 2rpx;
}

.tab.active {
  background: linear-gradient(135deg, rgba(0,180,216,0.18), rgba(6,214,160,0.08));
  color: #48cae4;
  font-weight: 700;
  box-shadow: 0 2rpx 12rpx rgba(0,180,216,0.1);
}

/* ═══════════════ Alert Items ═══════════════ */

.alert-list { position: relative; z-index: 1; }

.alert-item {
  position: relative;
  padding: 22rpx 24rpx 22rpx 30rpx;
  margin-bottom: 14rpx;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow:
    0 2rpx 16rpx rgba(0,0,0,0.2),
    inset 0 1rpx 0 rgba(255,255,255,0.02);
}
.alert-item.is-resolved { opacity: 0.55; }

/* Left color bar */
.alert-left-bar {
  position: absolute;
  left: 0; top: 14rpx; bottom: 14rpx;
  width: 4rpx;
  border-radius: 0 3rpx 3rpx 0;
}
.alert-left-bar.info     { background: #48cae4; box-shadow: 0 0 8rpx rgba(72,202,228,0.4); }
.alert-left-bar.warning  { background: #f0a500; box-shadow: 0 0 8rpx rgba(240,165,0,0.4); }
.alert-left-bar.critical { background: #ff6b6b; box-shadow: 0 0 8rpx rgba(255,107,107,0.4); }

.alert-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.alert-level {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}
.level-info     { background: rgba(0,180,216,0.15); color: #48cae4; }
.level-warning  { background: rgba(240,165,0,0.15); color: #f4c430; }
.level-critical { background: rgba(255,107,107,0.15); color: #ff8e8e; }

.alert-device { font-size: 22rpx; color: var(--text-muted); }

.alert-status {
  margin-left: auto;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}
.alert-status.active   { background: rgba(255,107,107,0.12); color: #ff8e8e; }
.alert-status.resolved { background: rgba(6,214,160,0.12); color: #06d6a0; }

.alert-msg {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.alert-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.alert-time { font-size: 22rpx; color: var(--text-muted); }

.alert-resolve {
  font-size: 24rpx;
  color: #48cae4;
  padding: 6rpx 20rpx;
  border: 1px solid rgba(0, 180, 216, 0.3);
  border-radius: 20rpx;
}

/* ═══════════════ Empty & Load More ═══════════════ */

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
  z-index: 1;
}
.empty-icon { font-size: 68rpx; opacity: 0.5; }
.empty-text { font-size: 30rpx; color: var(--text-secondary); font-weight: 600; }
.empty-sub  { font-size: 24rpx; color: var(--text-muted); }

.load-more {
  text-align: center;
  padding: 28rpx 0;
  margin-top: 8rpx;
  position: relative;
  z-index: 1;
}
.load-more text {
  font-size: 28rpx;
  color: #48cae4;
  font-weight: 500;
  padding: 12rpx 40rpx;
  border: 1px solid rgba(0, 180, 216, 0.2);
  border-radius: 30rpx;
}
