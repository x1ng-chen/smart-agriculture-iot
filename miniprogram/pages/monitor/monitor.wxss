.monitor { padding-bottom: 40rpx; }

.monitor-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 28rpx;
  margin: 20rpx 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.2);
}

.status-ring {
  width: 20rpx; height: 20rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-ring.connected    { background: rgba(34,197,94,0.2); }
.status-ring.disconnected { background: rgba(244,63,94,0.2); }

.status-ring-inner {
  width: 10rpx; height: 10rpx;
  border-radius: 50%;
}

.status-ring.connected .status-ring-inner    { background: #22c55e; box-shadow: 0 0 10rpx #22c55e; }
.status-ring.disconnected .status-ring-inner { background: #f43f5e; }

.status-text   { font-size: 26rpx; color: var(--text-secondary); font-weight: 500; }
.status-interval { font-size: 22rpx; color: var(--text-muted); margin-left: auto; }

/* 声波动效 */
.status-wave {
  display: flex; align-items: flex-end; gap: 4rpx; height: 20rpx;
}

.wave-bar {
  width: 4rpx;
  background: #22c55e;
  border-radius: 2rpx;
  animation: wave 1.2s ease-in-out infinite;
}
.wave-bar:nth-child(1) { height: 12rpx; animation-delay: 0s; }
.wave-bar:nth-child(2) { height: 20rpx; animation-delay: 0.2s; }
.wave-bar:nth-child(3) { height: 8rpx; animation-delay: 0.4s; }

@keyframes wave {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}

.device-grid { padding: 0 24rpx; }

.empty-state {
  text-align: center;
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-icon { font-size: 72rpx; opacity: 0.6; }
.empty-text { font-size: 30rpx; color: var(--text-secondary); font-weight: 600; }
.empty-sub  { font-size: 24rpx; color: var(--text-muted); }
