.login-page {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  overflow: hidden;
}

/* ═══════════════ Ambient Background ═══════════════ */

.login-bg {
  position: fixed; inset: 0;
  background:
    radial-gradient(ellipse at 30% 10%, rgba(0, 180, 216, 0.1) 0%, transparent 55%),
    radial-gradient(ellipse at 70% 45%, rgba(6, 214, 160, 0.06) 0%, transparent 50%),
    radial-gradient(ellipse at 25% 80%, rgba(0, 180, 216, 0.04) 0%, transparent 45%),
    linear-gradient(180deg, #0B0F19 0%, #111624 50%, #0B0F19 100%);
}

/* ═══════════════ Floating Particles ═══════════════ */

.login-particles {
  position: fixed; inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.particle {
  position: absolute;
  top: calc(var(--x) + 50%);
  left: var(--x);
  width: 6rpx; height: 6rpx;
  border-radius: 50%;
  background: rgba(0, 180, 216, 0.25);
  box-shadow: 0 0 12rpx rgba(0, 180, 216, 0.2);
  animation: particle-float var(--d) ease-in-out infinite;
  animation-delay: calc(var(--i) * -1.5s);
}

@keyframes particle-float {
  0%, 100% { transform: translateY(0) translateX(0); opacity: 0; }
  20%      { opacity: 0.7; }
  50%      { transform: translateY(-60rpx) translateX(30rpx); opacity: 0.4; }
  80%      { opacity: 0.7; }
}

/* ═══════════════ Login Card ═══════════════ */

.login-card {
  position: relative; z-index: 1;
  width: 620rpx;
  padding: 64rpx 48rpx 52rpx;
  background: linear-gradient(180deg, rgba(20,28,44,0.85) 0%, rgba(14,20,32,0.92) 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 28rpx;
  box-shadow:
    0 32rpx 96rpx rgba(0, 0, 0, 0.55),
    0 0 80rpx rgba(0, 180, 216, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.03);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: cardEnter 0.6s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes cardEnter {
  from { opacity: 0; transform: translateY(40rpx) scale(0.95); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* Top glow bar */
.login-card-bar {
  position: absolute;
  top: 0; left: 15%; right: 15%;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #00b4d8, #48cae4, #06d6a0, transparent);
  border-radius: 50%;
}

/* ═══════════════ Logo ═══════════════ */

.login-logo {
  width: 130rpx; height: 130rpx;
  border-radius: 65rpx;
  background: linear-gradient(135deg, rgba(0,180,216,0.15), rgba(6,214,160,0.06));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  border: 2rpx solid rgba(0, 180, 216, 0.2);
  box-shadow: 0 12rpx 48rpx rgba(0, 180, 216, 0.08);
  animation: float 4s ease-in-out infinite;
}
.logo-text { font-size: 60rpx; }

/* ═══════════════ Text ═══════════════ */

.login-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.login-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 56rpx;
  letter-spacing: 1rpx;
}

/* ═══════════════ Login Button ═══════════════ */

.login-btn {
  position: relative;
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #00b4d8 0%, #0096c7 100%);
  border-radius: 46rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 36rpx rgba(0, 180, 216, 0.3);
  overflow: hidden;
}

.btn-shine {
  position: absolute;
  top: 0; left: -80%;
  width: 60%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.12), transparent);
  transform: skewX(-15deg);
  animation: btn-shimmer 3s ease-in-out infinite;
}
@keyframes btn-shimmer {
  0%, 100% { left: -80%; }
  50%      { left: 120%; }
}

.btn-text {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  position: relative;
  z-index: 1;
}

.login-notice {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
}

/* ═══════════════ Error ═══════════════ */

.login-error {
  margin-top: 24rpx;
  padding: 16rpx 28rpx;
  background: rgba(255, 107, 107, 0.08);
  border-radius: 12rpx;
  border: 1px solid rgba(255, 107, 107, 0.2);
  width: 100%;
  text-align: center;
}
.login-error text { font-size: 24rpx; color: #ff8e8e; }
