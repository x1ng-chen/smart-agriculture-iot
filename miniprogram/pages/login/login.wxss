.login-page {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  overflow: hidden;
}

.login-bg {
  position: fixed; inset: 0;
  background:
    radial-gradient(ellipse at 40% 15%, rgba(245,158,11,0.12) 0%, transparent 55%),
    radial-gradient(ellipse at 75% 70%, rgba(249,115,22,0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 20% 85%, rgba(244,63,94,0.06) 0%, transparent 45%),
    linear-gradient(180deg, #1a1008 0%, #120c04 100%);
}

.login-card {
  position: relative; z-index: 1;
  width: 620rpx;
  padding: 64rpx 48rpx 52rpx;
  background: linear-gradient(180deg, rgba(35,22,10,0.85) 0%, rgba(24,14,6,0.9) 100%);
  border: 1rpx solid rgba(245,158,11,0.18);
  border-radius: 28rpx;
  box-shadow:
    0 24rpx 80rpx rgba(0,0,0,0.5),
    0 0 80rpx rgba(245,158,11,0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeInUp 0.45s ease;
}

/* 卡片顶部光条 */
.login-card::before {
  content: '';
  position: absolute;
  top: 0; left: 15%; right: 15%;
  height: 3rpx;
  background: linear-gradient(90deg, transparent, #f59e0b, #fbbf24, #f97316, transparent);
  border-radius: 50%;
}

.login-logo {
  width: 130rpx; height: 130rpx;
  border-radius: 65rpx;
  background: linear-gradient(135deg, rgba(245,158,11,0.18), rgba(249,115,22,0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 36rpx;
  border: 2rpx solid rgba(245,158,11,0.25);
  box-shadow: 0 12rpx 40rpx rgba(245,158,11,0.1);
}

.logo-text { font-size: 60rpx; }

.login-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.login-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 56rpx;
  letter-spacing: 1rpx;
}

.login-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #f97316 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 46rpx;
  border: none;
  margin-bottom: 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(245,158,11,0.3);
  transition: all 0.2s ease;
}

.login-btn-hover {
  transform: scale(0.96);
  box-shadow: 0 6rpx 20rpx rgba(245,158,11,0.2);
  opacity: 0.9;
}

.login-notice {
  font-size: 22rpx;
  color: var(--text-muted);
  text-align: center;
}

.login-error {
  margin-top: 24rpx;
  padding: 16rpx 28rpx;
  background: rgba(244,63,94,0.08);
  border-radius: 12rpx;
  border: 1rpx solid rgba(244,63,94,0.2);
  width: 100%;
  text-align: center;
}

.login-error text {
  font-size: 24rpx;
  color: var(--accent-rose);
}
