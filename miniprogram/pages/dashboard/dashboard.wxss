.dashboard { padding-bottom: 40rpx; }

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 24rpx 8rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-sub {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 设备列表 */
.device-list { display: flex; flex-direction: column; gap: 10rpx; }

.device-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: rgba(245,158,11,0.03);
  border: 1rpx solid rgba(245,158,11,0.06);
  transition: all 0.2s ease;
}

.device-item:active {
  background: rgba(245,158,11,0.08);
  border-color: rgba(245,158,11,0.15);
  transform: scale(0.985);
}

.device-dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.device-dot.on { background: #22c55e; box-shadow: 0 0 12rpx rgba(34,197,94,0.5); animation: glow-pulse 2s infinite; }
.device-dot.off { background: #f43f5e; }

.device-info { flex: 1; min-width: 0; }
.device-name { font-size: 28rpx; color: var(--text-primary); font-weight: 500; }
.device-sn-mini { font-size: 22rpx; color: var(--text-muted); font-family: 'Courier New', monospace; }

.device-status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  white-space: nowrap;
}

.device-status-badge.online  { background: rgba(34,197,94,0.12); color: #4ade80; }
.device-status-badge.offline { background: rgba(244,63,94,0.12); color: #f87171; }

/* 告警列表 */
.alert-list { display: flex; flex-direction: column; gap: 10rpx; }

.alert-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: rgba(245,158,11,0.03);
  border: 1rpx solid rgba(245,158,11,0.05);
  font-size: 24rpx;
  transition: background 0.2s;
}

.alert-row:active { background: rgba(245,158,11,0.07); }

.alert-level {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.level-info    { background: rgba(96,165,250,0.18); color: #93c5fd; }
.level-warning { background: rgba(245,158,11,0.18); color: #fbbf24; }
.level-critical { background: rgba(244,63,94,0.18); color: #fda4af; }

.alert-msg {
  flex: 1;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alert-time {
  color: var(--text-muted);
  white-space: nowrap;
  font-size: 22rpx;
}

.empty-tip {
  text-align: center;
  color: var(--text-muted);
  padding: 32rpx 0;
  font-size: 24rpx;
}
