<view class="dashboard page-enter">
  <view class="ambient-bg"></view>

  <!-- 统计卡片网格 -->
  <view class="stat-grid">
    <view class="stat-card-wrapper stagger-item" wx:for="{{statCards}}" wx:key="color" style="animation-delay: {{index * 0.08}}s">
      <view class="stat-card spring-press {{item.color}}" bindtouchstart="onCardTouch" bindtouchend="onCardRelease" data-key="{{item.color}}">
        <view class="stat-card-bg"></view>
        <view class="stat-card-shine"></view>
        <view class="stat-card-glow"></view>
        <view class="stat-card-content">
          <view class="stat-icon-box">
            <text>{{item.icon}}</text>
          </view>
          <view class="stat-info">
            <view class="stat-value">{{item.value}}</view>
            <view class="stat-label">{{item.label}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 设备在线状态 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">设备在线状态</text>
      <text class="section-sub">共 {{deviceCount}} 台</text>
    </view>
    <view class="device-list">
      <view class="device-item spring-press stagger-item" wx:for="{{stats.onlineDeviceList}}" wx:key="id" style="animation-delay: {{0.25 + index * 0.07}}s" bindtouchstart="onItemTouch" bindtouchend="onItemRelease">
        <view class="device-dot {{item.online_status === 1 ? 'on' : 'off'}}">
          <view class="dot-pulse" wx:if="{{item.online_status === 1}}"></view>
        </view>
        <view class="device-info">
          <view class="device-name">{{item.device_name}}</view>
          <view class="device-sn-mini">{{item.device_sn}}</view>
        </view>
        <view class="device-status-badge {{item.online_status === 1 ? 'online' : 'offline'}}">
          {{item.online_status === 1 ? '在线' : '离线'}}
        </view>
      </view>
      <view class="empty-tip" wx:if="{{deviceCount === 0}}">暂无设备</view>
    </view>
  </view>

  <!-- 近期告警 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">近期告警</text>
      <text class="section-sub" wx:if="{{alertCount > 0}}">{{alertCount}} 条</text>
    </view>
    <view class="alert-list">
      <view class="alert-row spring-press stagger-item" wx:for="{{stats.recentAlerts}}" wx:key="id" style="animation-delay: {{0.35 + index * 0.07}}s" bindtouchstart="onItemTouch" bindtouchend="onItemRelease">
        <view class="alert-level level-{{item.alert_level}}">{{alertLevelMap[item.alert_level] || item.alert_level}}</view>
        <view class="alert-msg">{{item.message}}</view>
        <view class="alert-time">{{item.created_at}}</view>
      </view>
      <view class="empty-tip" wx:if="{{alertCount === 0}}">暂无告警 🎉</view>
    </view>
  </view>
</view>
