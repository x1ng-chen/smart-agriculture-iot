.device-card {
  position: relative;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.3), inset 0 1rpx 0 rgba(255,255,255,0.02);
  animation: staggerIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
.device-card.offline { opacity: 0.5; }

.card-top-bar { height: 4rpx; }
.bar-online  { background: linear-gradient(90deg, #00b4d8, #48cae4, #06d6a0); }
.bar-offline { background: linear-gradient(90deg, #5c6885, #3d4760); }

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 14rpx;
}
.card-header-left { display: flex; align-items: center; gap: 12rpx; }

.card-dot { width: 14rpx; height: 14rpx; border-radius: 50%; position: relative; display: flex; align-items: center; justify-content: center; }
.dot-on  { background: #06d6a0; animation: glow-pulse-green 2s infinite; }
.dot-off { background: #ff6b6b; }

.dot-pulse {
  position: absolute;
  width: 28rpx; height: 28rpx;
  border-radius: 50%;
  border: 1px solid rgba(6,214,160,0.3);
  animation: dot-ripple 1.8s ease-out infinite;
}
@keyframes dot-ripple {
  0%   { transform: scale(0.5); opacity: 0.8; }
  100% { transform: scale(1.8); opacity: 0; }
}

.card-name { font-weight: 600; font-size: 30rpx; color: var(--text-primary); }
.card-sn {
  font-size: 22rpx; color: var(--text-muted);
  font-family: 'Courier New', monospace;
  background: rgba(0,0,0,0.25);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1px solid var(--border-color);
}

.card-sensors { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; padding: 8rpx 24rpx 20rpx; }
.card-footer { padding: 0 24rpx 24rpx; }

.irrigate-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #00b4d8 0%, #0096c7 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(0,180,216,0.25);
}
.btn-icon { font-size: 28rpx; }
