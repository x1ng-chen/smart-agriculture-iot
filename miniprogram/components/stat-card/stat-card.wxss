.stat-card {
  position: relative;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.stat-card:active {
  transform: scale(0.965);
  box-shadow: 0 6rpx 30rpx rgba(0,0,0,0.5);
}

.stat-card-bg {
  position: absolute; inset: 0;
  background: var(--bg-card);
  border: 1rpx solid var(--border-color);
  border-radius: 20rpx;
}

/* 顶部光条 */
.stat-card-glow {
  position: absolute;
  top: 0; left: 10%; right: 10%;
  height: 3rpx;
  border-radius: 50%;
}

.stat-card.amber  .stat-card-glow { background: linear-gradient(90deg, transparent, #f59e0b, #fbbf24, transparent); }
.stat-card.coral  .stat-card-glow { background: linear-gradient(90deg, transparent, #f97316, #fb923c, transparent); }
.stat-card.rose   .stat-card-glow { background: linear-gradient(90deg, transparent, #f43f5e, #fb7185, transparent); }
.stat-card.green  .stat-card-glow { background: linear-gradient(90deg, transparent, #22c55e, #4ade80, transparent); }

/* 微光扫过 */
.stat-card-shine {
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.015) 0%, transparent 50%);
  pointer-events: none;
}

.stat-card-sparkle {
  position: absolute;
  top: 8rpx; right: 16rpx;
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  opacity: 0.5;
}

.stat-card.amber  .stat-card-sparkle { background: #fbbf24; box-shadow: 0 0 6rpx #fbbf24; }
.stat-card.coral  .stat-card-sparkle { background: #fb923c; box-shadow: 0 0 6rpx #fb923c; }
.stat-card.rose   .stat-card-sparkle { background: #fb7185; box-shadow: 0 0 6rpx #fb7185; }
.stat-card.green  .stat-card-sparkle { background: #4ade80; box-shadow: 0 0 6rpx #4ade80; }

/* 内容区 */
.stat-card-content {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 20rpx;
}

.stat-icon-box {
  width: 80rpx; height: 80rpx;
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 38rpx;
  transition: transform 0.2s ease;
}

.stat-card:active .stat-icon-box { transform: scale(1.08); }

.stat-card.amber  .stat-icon-box { background: rgba(245,158,11,0.12); color: #f59e0b; }
.stat-card.coral  .stat-icon-box { background: rgba(249,115,22,0.12); color: #f97316; }
.stat-card.rose   .stat-icon-box { background: rgba(244,63,94,0.12); color: #f43f5e; }
.stat-card.green  .stat-icon-box { background: rgba(34,197,94,0.12); color: #22c55e; }

.stat-value {
  font-size: 44rpx; font-weight: 800;
  font-family: 'Courier New', monospace;
  color: var(--text-primary);
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 2rpx;
}
