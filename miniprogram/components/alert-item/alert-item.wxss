.alert-item {
  position: relative;
  padding: 22rpx 24rpx;
  background: var(--bg-card);
  border-radius: 14rpx;
  margin-bottom: 14rpx;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.2);
  transition: transform 0.2s ease;
}

.alert-item:active { transform: scale(0.985); }

/* 左边框颜色 */
.alert-item::before {
  content: '';
  position: absolute;
  left: 0; top: 12rpx; bottom: 12rpx;
  width: 4rpx;
  border-radius: 0 2rpx 2rpx 0;
}

.alert-item.info::before    { background: #60a5fa; }
.alert-item.warning::before { background: #f59e0b; }
.alert-item.critical::before { background: #f43f5e; }

.alert-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.alert-level {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.level-info    { background: rgba(96,165,250,0.18); color: #93c5fd; }
.level-warning { background: rgba(245,158,11,0.18); color: #fbbf24; }
.level-critical { background: rgba(244,63,94,0.18); color: #fda4af; }

.alert-device {
  font-size: 22rpx;
  color: var(--text-muted);
}

.alert-status {
  margin-left: auto;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.alert-status.active   { background: rgba(244,63,94,0.12); color: #f87171; }
.alert-status.resolved { background: rgba(34,197,94,0.12); color: #4ade80; }

.alert-msg {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.alert-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.alert-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.alert-resolve {
  font-size: 24rpx;
  color: var(--accent);
  padding: 6rpx 20rpx;
  border: 1rpx solid rgba(245,158,11,0.35);
  border-radius: 20rpx;
  transition: all 0.2s;
}

.alert-resolve:active {
  background: rgba(245,158,11,0.15);
  border-color: var(--accent);
}
