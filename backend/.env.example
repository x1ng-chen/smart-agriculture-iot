# ===========================================
# 智慧农业灌溉系统 — 环境变量配置模板
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ===========================================

# 服务端口
SERVER_PORT=8080
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=smart_agriculture

# JWT (生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=YOUR_JWT_SECRET_RANDOM_48_BYTES_BASE64
JWT_EXPIRE_HOURS=24

# 数据加密密钥 (AES-256-GCM, 生成方式: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=YOUR_64_CHAR_HEX_ENCRYPTION_KEY

# Serial Gateway
SERIAL_AUTO_CONNECT=true
SERIAL_DEFAULT_BAUD=115200
SERIAL_RECONNECT_MAX_ATTEMPTS=5

# Huawei Cloud IoTDA
HUAWEI_IOT_ENABLED=true
HUAWEI_IOT_ENDPOINT=YOUR_IOT_ENDPOINT.iotda-app.cn-north-4.myhuaweicloud.com
HUAWEI_IOT_PROJECT_ID=YOUR_HUAWEI_PROJECT_ID
HUAWEI_IOT_DEVICE_ID=YOUR_PRODUCT_ID_smart-001
HUAWEI_IOT_AK=YOUR_HUAWEI_ACCESS_KEY
HUAWEI_IOT_SK=YOUR_HUAWEI_SECRET_KEY
HUAWEI_IOT_PRODUCT_ID=YOUR_HUAWEI_PRODUCT_ID
HUAWEI_IOT_REGION=cn-north-4
HUAWEI_IOT_SERVICE=iotda

# 华为云 IAM 认证 (用于 REST API Token 获取)
HUAWEI_IAM_USERNAME=YOUR_IAM_USERNAME
HUAWEI_IAM_PASSWORD=YOUR_IAM_PASSWORD
HUAWEI_IAM_DOMAIN_ID=YOUR_HUAWEI_DOMAIN_ID
HUAWEI_PROJECT_ID=YOUR_HUAWEI_PROJECT_ID
HUAWEI_DOMAIN_ID=YOUR_HUAWEI_DOMAIN_ID
HUAWEI_PRODUCT_ID=YOUR_HUAWEI_PRODUCT_ID

# 微信小程序
WECHAT_APPID=YOUR_WECHAT_APPID
WECHAT_APPSECRET=YOUR_WECHAT_APPSECRET

# InfluxDB (时序数据库)
INFLUXDB_URL=http://127.0.0.1:8086
INFLUXDB_TOKEN=YOUR_INFLUXDB_TOKEN
INFLUXDB_ORG=smart-agriculture
INFLUXDB_BUCKET=sensor_data

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Webhook 安全 (token=简单Token验证, signature=华为HMAC-SHA256, none=关闭)
WEBHOOK_AUTH_MODE=token
WEBHOOK_FIXED_TOKEN=YOUR_WEBHOOK_SECRET_TOKEN
WEBHOOK_SIGNATURE_TOKEN=
WEBHOOK_DEDUP_TTL=300

# 传感器故障码 (逗号分隔)
SENSOR_FAULT_CODES=999,998

# AI 决策冷却 (秒)
AI_DECISION_COOLDOWN=300

# 小米 MiMo AI
MIMO_API_KEY=YOUR_MIMO_API_KEY
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_CHAT_MODEL=mimo-v2.5-pro
MIMO_DECISION_MODEL=mimo-v2.5-pro
