# Service
SERVER_PORT=8080
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=smart_agriculture

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRE_HOURS=24

# Serial Gateway
SERIAL_AUTO_CONNECT=false
SERIAL_DEFAULT_BAUD=115200
SERIAL_RECONNECT_MAX_ATTEMPTS=5

# Huawei Cloud IoT
HUAWEI_IOT_ENABLED=false
HUAWEI_IOT_ENDPOINT=your_iot_endpoint
HUAWEI_IOT_PROJECT_ID=your_project_id
HUAWEI_IOT_DEVICE_ID=your_device_id
HUAWEI_IOT_AK=your_access_key
HUAWEI_IOT_SK=your_secret_key
HUAWEI_IOT_PRODUCT_ID=your_product_id
